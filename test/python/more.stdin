class Vec:
    def __init__(self, x, y):
        self.x, self.y = x, y
    def __add__(self, o):
        return Vec(self.x + o.x, self.y + o.y)
    def __repr__(self):
        return "Vec(%d, %d)" % (self.x, self.y)

Vec(1, 2) + Vec(3, 4)
