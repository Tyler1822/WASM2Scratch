(module
  ;;@prelude
  (func $main (export "_start")
    (local $i i32)
    ;; byte/halfword stores and signed/unsigned loads
    (i32.store (i32.const 100) (i32.const 0x89abcdef))
    (call $p (i32.load8_u (i32.const 100)))
    (call $p (i32.load8_s (i32.const 100)))
    (call $p (i32.load8_s (i32.const 103)))
    (call $p (i32.load16_u (i32.const 102)))
    (call $p (i32.load16_s (i32.const 102)))
    (i32.store8 (i32.const 101) (i32.const 0x1234))
    (i32.store16 (i32.const 102) (i32.const -2))
    (call $p (i32.load (i32.const 100)))
    ;; unaligned accesses (align=1)
    (i32.store align=1 (i32.const 201) (i32.const 0x11223344))
    (call $p (i32.load align=1 (i32.const 201)))
    (call $p (i32.load (i32.const 200)))
    (call $p (i32.load16_u align=1 (i32.const 203)))
    (i64.store align=1 (i32.const 303) (i64.const 0x0102030405060708))
    (call $p64 (i64.load align=1 (i32.const 303)))
    (call $p64 (i64.load32_s align=1 (i32.const 303)))
    (i64.store (i32.const 400) (i64.const -5))
    (call $p64 (i64.load (i32.const 400)))
    (call $p64 (i64.load32_u (i32.const 404)))
    (call $p64 (i64.load16_s (i32.const 400)))
    (call $p64 (i64.load8_u (i32.const 401)))
    (i64.store8 (i32.const 400) (i64.const 0x7f))
    (call $p64 (i64.load (i32.const 400)))
    ;; f32/f64 round trip through memory
    (f64.store (i32.const 512) (f64.const -1234.5625))
    (call $pf (f64.load (i32.const 512)))
    (f32.store (i32.const 520) (f32.const 3.25))
    (call $p (i32.load (i32.const 520)))
    ;; offsets
    (i32.store offset=16 (i32.const 600) (i32.const 77))
    (call $p (i32.load offset=12 (i32.const 604)))
    ;; memory.size / grow
    (call $p (memory.size))
    (call $p (memory.grow (i32.const 1)))
    (call $p (memory.size))
    (i32.store (i32.const 140000) (i32.const 4242))
    (call $p (i32.load (i32.const 140000)))
    ;; bulk memory: fill and (overlapping) copy
    (memory.fill (i32.const 1001) (i32.const 0xAB) (i32.const 13))
    (call $p (i32.load (i32.const 1000)))
    (call $p (i32.load (i32.const 1012)))
    (call $p (i32.load (i32.const 1016)))
    (local.set $i (i32.const 0))
    (loop $l
      (i32.store8 (i32.add (i32.const 2000) (local.get $i)) (local.get $i))
      (br_if $l (i32.lt_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 40))))
    (memory.copy (i32.const 2003) (i32.const 2000) (i32.const 20))
    (call $p (i32.load (i32.const 2004)))
    (call $p (i32.load (i32.const 2020)))
    (memory.copy (i32.const 2000) (i32.const 2002) (i32.const 30))
    (call $p (i32.load (i32.const 2000)))
    (call $p (i32.load (i32.const 2024)))
    (memory.copy (i32.const 3000) (i32.const 2000) (i32.const 32))
    (call $p (i32.load (i32.const 3028)))
    ;; store value that reads the same memory (ordering of i64 halves)
    (i64.store (i32.const 4000) (i64.const 0x00000001ffffffff))
    (i64.store (i32.const 4000) (i64.add (i64.load (i32.const 4000)) (i64.const 1)))
    (call $p64 (i64.load (i32.const 4000)))))
