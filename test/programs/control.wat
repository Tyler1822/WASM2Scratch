(module
  ;;@prelude
  ;; switch via br_table with fallthrough-style nesting
  (func $classify (param $n i32) (result i32)
    (block $default
      (block $c3
        (block $c2
          (block $c1
            (block $c0
              (br_table $c0 $c1 $c2 $c3 $c1 $default (local.get $n)))
            (return (i32.const 100)))
          (return (i32.const 101)))
        (return (i32.const 102)))
      (return (i32.const 103)))
    (i32.const -1))
  ;; block with a result value carried by br_if
  (func $firstDiv (param $n i32) (result i32)
    (local $d i32)
    (local.set $d (i32.const 2))
    (block $found (result i32)
      (loop $try
        (br_if $found (local.get $n) (i32.gt_u (i32.mul (local.get $d) (local.get $d)) (local.get $n)))
        (br_if $found (local.get $d) (i32.eqz (i32.rem_u (local.get $n) (local.get $d))))
        (local.set $d (i32.add (local.get $d) (i32.const 1)))
        (br $try))
      (unreachable)))
  ;; nested loops with break/continue to outer labels
  (func $pairs (param $n i32) (result i32)
    (local $i i32) (local $j i32) (local $c i32)
    (block $outerDone
      (loop $outer
        (local.set $j (i32.const 0))
        (block $innerDone
          (loop $inner
            (br_if $innerDone (i32.ge_u (local.get $j) (local.get $i)))
            (local.set $j (i32.add (local.get $j) (i32.const 1)))
            (br_if $inner (i32.and (local.get $j) (i32.const 1)))
            (local.set $c (i32.add (local.get $c) (local.get $j)))
            (br_if $outerDone (i32.gt_u (local.get $c) (i32.const 500)))
            (br $inner)))
        (local.set $i (i32.add (local.get $i) (i32.const 1)))
        (br_if $outer (i32.lt_u (local.get $i) (local.get $n)))))
    (local.get $c))
  ;; if/else with results and select
  (func $sel (param $a i32) (param $b i32) (result i32)
    (i32.add
      (if (result i32) (i32.lt_s (local.get $a) (local.get $b))
        (then (i32.sub (local.get $b) (local.get $a)))
        (else (i32.mul (local.get $a) (i32.const 3))))
      (select (i32.const 1000) (i32.const 2000) (i32.and (local.get $a) (i32.const 1)))))
  (func $fsel (param $x f64) (result f64)
    (select (f64.const inf) (f64.neg (local.get $x)) (f64.gt (local.get $x) (f64.const 1))))
  ;; multi-value: function returning two values, block with params
  (func $divmod (param $a i32) (param $b i32) (result i32 i32)
    (i32.div_u (local.get $a) (local.get $b))
    (i32.rem_u (local.get $a) (local.get $b)))
  (func $useBlockParams (param $x i32) (result i32)
    (local.get $x)
    (i32.const 7)
    (block (param i32 i32) (result i32)
      (i32.add)
      (i32.const 2)
      (i32.mul)))
  (func $loopParam (param $n i32) (result i32)
    (local $acc i32)
    (i32.const 1)
    (loop $l (param i32) (result i32)
      (local.set $acc (i32.add (local.get $acc) (local.get $n)))
      (i32.mul (i32.const 2))
      (local.tee $n (i32.sub (local.get $n) (i32.const 1)))
      (br_if 0 (i32.gt_s (local.get $n) (i32.const 0)))
      (drop)
      (i32.add (local.get $acc)))
  )
  ;; value kept on the stack while locals change underneath it
  (func $stackOrder (result i32)
    (local $x i32)
    (local.set $x (i32.const 5))
    (local.get $x)
    (local.set $x (i32.const 100))
    (local.get $x)
    (i32.sub))
  (func $early (param $x i32) (result i32)
    (block
      (br_if 0 (i32.eqz (local.get $x)))
      (if (i32.gt_s (local.get $x) (i32.const 10)) (then (return (i32.const 1))))
      (return (i32.const 2)))
    (i32.const 3))
  (func $main (export "_start")
    (local $i i32)
    (loop $l
      (call $p (call $classify (local.get $i)))
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (br_if $l (i32.lt_u (local.get $i) (i32.const 8))))
    (call $p (call $classify (i32.const -1)))
    (call $p (call $firstDiv (i32.const 91)))
    (call $p (call $firstDiv (i32.const 97)))
    (call $p (call $firstDiv (i32.const 1000001)))
    (call $p (call $pairs (i32.const 10)))
    (call $p (call $pairs (i32.const 100)))
    (call $p (call $sel (i32.const 3) (i32.const 10)))
    (call $p (call $sel (i32.const 10) (i32.const 3)))
    (call $p (call $sel (i32.const -4) (i32.const -9)))
    (call $pf (call $fsel (f64.const 2)))
    (call $pf (call $fsel (f64.const 0.5)))
    (call $divmod (i32.const 47) (i32.const 5))
    (call $p)
    (call $p)
    (call $p (call $useBlockParams (i32.const 5)))
    (call $p (call $loopParam (i32.const 5)))
    (call $p (call $stackOrder))
    (call $p (call $early (i32.const 0)))
    (call $p (call $early (i32.const 5)))
    (call $p (call $early (i32.const 50)))))
