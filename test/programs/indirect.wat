(module
  ;;@prelude
  (type $binop (func (param i32 i32) (result i32)))
  (table 8 funcref)
  (elem (i32.const 1) $add $sub $mul $fact)
  (global $counter (mut i32) (i32.const 10))
  (global $big (mut i64) (i64.const 0x123456789))
  (global $k i32 (i32.const 7))
  (func $add (param i32 i32) (result i32) (i32.add (local.get 0) (local.get 1)))
  (func $sub (param i32 i32) (result i32) (i32.sub (local.get 0) (local.get 1)))
  (func $mul (param i32 i32) (result i32) (i32.mul (local.get 0) (local.get 1)))
  (func $fact (param $n i32) (param $unused i32) (result i32)
    (global.set $counter (i32.add (global.get $counter) (i32.const 1)))
    (if (result i32) (i32.le_s (local.get $n) (i32.const 1))
      (then (i32.const 1))
      (else (i32.mul (local.get $n)
              (call_indirect (type $binop) (i32.sub (local.get $n) (i32.const 1)) (i32.const 0) (i32.const 4))))))
  (func $main (export "_start")
    (local $i i32)
    (local.set $i (i32.const 1))
    (loop $l
      (call $p (call_indirect (type $binop) (i32.const 12) (i32.const 5) (local.get $i)))
      (br_if $l (i32.le_u (local.tee $i (i32.add (local.get $i) (i32.const 1))) (i32.const 4))))
    (call $p (global.get $counter))
    (global.set $big (i64.mul (global.get $big) (i64.extend_i32_u (global.get $k))))
    (call $p64 (global.get $big))))
